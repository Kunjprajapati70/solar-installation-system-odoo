# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/solar_installation_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRE=30d

# SMTP (forgot-password OTP). Use a Gmail App Password or your org mail relay.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SunPower Solutions <your-smtp-user@gmail.com>

# File Uploads Directory (Relative or Absolute)
UPLOAD_PATH=uploads

# System Defaults (Configurable Warranty Durations in Months)
WARRANTY_PANEL_MONTHS=240
WARRANTY_INVERTER_MONTHS=24
WARRANTY_BATTERY_MONTHS=24
WARRANTY_STRUCTURE_MONTHS=60
